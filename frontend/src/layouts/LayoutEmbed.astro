---
// Layout sin header ni navegación, pensado para incrustarse con <iframe>
// en sitios externos (ej. venseremos.co). Reporta su alto al sitio padre
// para que el iframe crezca sin barra de scroll interna.
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Rendición de cuentas — Concejo 360',
  description = 'Actividad de un concejal de Medellín según datos públicos del SIMI.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=Montserrat:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="antialiased">
    <slot />
    <script is:inline>
      (function () {
        if (window.parent === window) return;
        var ultimo = 0;
        function avisar() {
          var alto = document.documentElement.scrollHeight;
          if (alto === ultimo) return;
          ultimo = alto;
          window.parent.postMessage({ tipo: 'concejo360-alto', alto: alto }, '*');
        }
        new ResizeObserver(avisar).observe(document.body);
        window.addEventListener('load', avisar);
      })();
    </script>
  </body>
</html>
