---
import Layout from '../layouts/Layout.astro';
import ComparativoConcejales from '../components/ComparativoConcejales.jsx';
---

<Layout
  title="Comparativo — Concejo 360"
  description="Comparar la producción legislativa de los concejales de Medellín por periodo: proyectos, acuerdos, efectividad y perfil."
>
  <section class="mb-8">
    <p class="text-xs font-semibold uppercase tracking-wide text-brand-700">Comparativo</p>
    <h1 class="mt-2 text-3xl md:text-4xl font-bold text-slate-900">
      Comparar concejales
    </h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      ¿Este concejal está por encima o por debajo del promedio? Producción legislativa comparada,
      siempre con la advertencia de que un perfil de control político no se mide solo con acuerdos.
    </p>
  </section>

  <ComparativoConcejales client:load />
</Layout>
