---
import Layout from '../layouts/Layout.astro';
import ControlPolitico from '../components/ControlPolitico.jsx';
---

<Layout
  title="Control político — Concejo 360"
  description="Citaciones, invitaciones y comisiones accidentales del Concejo de Medellín: a quién se vigila, sobre qué temas y con qué resultado."
>
  <section class="mb-8">
    <p class="text-xs font-semibold uppercase tracking-wide text-brand-700">Control político</p>
    <h1 class="mt-2 text-3xl md:text-4xl font-bold text-slate-900">
      Vigilancia a la administración
    </h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      ¿Quién vigila a la administración y sobre qué temas? Citaciones, invitaciones y comisiones
      accidentales con filtros por tipo, año y entidad. Pensado para periodistas y veedurías.
    </p>
  </section>

  <ControlPolitico client:load />
</Layout>
