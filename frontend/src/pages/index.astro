---
import Layout from '../layouts/Layout.astro';
import VistaConcejo from '../components/VistaConcejo.jsx';
---

<Layout>
  <section class="mb-8">
    <p class="text-xs font-semibold uppercase tracking-wide text-brand-700">Vista Concejo</p>
    <h1 class="mt-2 text-3xl md:text-4xl font-bold text-slate-900">
      ¿Qué hace el Concejo de Medellín?
    </h1>
    <p class="mt-2 max-w-2xl text-slate-600">
      Panorama institucional con datos abiertos extraídos de SIMI: sesiones, proyectos de acuerdo,
      acuerdos sancionados, control político y comisiones. Compará el periodo actual contra el anterior
      antes de juzgar a un concejal individual.
    </p>
  </section>

  <VistaConcejo client:load />
</Layout>
