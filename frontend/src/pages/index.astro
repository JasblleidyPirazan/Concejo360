---
import Layout from '../layouts/Layout.astro';
import GlobalDashboard from '../components/GlobalDashboard.jsx';
---

<Layout>
  <section class="mb-8">
    <p class="text-xs font-semibold uppercase tracking-wide text-brand-700">Transparencia</p>
    <h1 class="mt-2 text-3xl md:text-4xl font-bold text-slate-900">
      Concejo 360
    </h1>
    <p class="mt-2 max-w-2xl text-slate-600">
      Visor de datos abiertos extraídos de SIMI. Indicadores de actividad del Concejo de Medellín
      por periodo: proyectos, acuerdos, comisiones, citaciones e invitaciones.
    </p>
  </section>

  <GlobalDashboard client:load />
</Layout>
