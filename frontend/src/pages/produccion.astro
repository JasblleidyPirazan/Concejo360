---
import Layout from '../layouts/Layout.astro';
import ProduccionLegislativa from '../components/ProduccionLegislativa.jsx';
---

<Layout
  title="Producción legislativa — Concejo 360"
  description="Proyectos de acuerdo radicados ante el Concejo de Medellín: estado, comisión, proponentes y días de trámite."
>
  <section class="mb-8">
    <p class="text-xs font-semibold uppercase tracking-wide text-brand-700">Producción legislativa</p>
    <h1 class="mt-2 text-3xl md:text-4xl font-bold text-slate-900">
      Proyectos de acuerdo
    </h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      ¿Qué proyectos hay vivos, quiénes los empujan y dónde están atascados? Seguimiento legislativo
      con filtros por año, comisión, etapa y proponente. Pensado para periodistas y veedurías.
    </p>
  </section>

  <ProduccionLegislativa client:load />
</Layout>
